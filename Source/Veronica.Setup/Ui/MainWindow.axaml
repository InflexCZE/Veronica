<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="using:FluentAvalonia.UI.Controls"
        xmlns:ui="using:Veronica.Setup.Ui"
        x:Class="Veronica.Setup.Ui.MainWindow"
        x:DataType="ui:MainViewModel"
        Title="{Binding Title}"
        Icon="/Assets/Veronica.ico"
        Width="1090" Height="664" MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Surface0Brush}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="PreferSystemChrome"
        ExtendClientAreaTitleBarHeightHint="-1">

  <Window.Styles>
    <Style Selector="Button.bare">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="3" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.bare:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.bare:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.bare:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Button.arrow">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.arrow Path">
      <Setter Property="Stroke" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="StrokeThickness" Value="1.6" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
    </Style>
    <Style Selector="Button.arrow:disabled Path">
      <Setter Property="Stroke" Value="{DynamicResource TextMutedBrush}" />
    </Style>
    <Style Selector="Button.arrow:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Border.dotBar">
      <Setter Property="Width" Value="8" />
      <Setter Property="Height" Value="8" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Background" Value="{DynamicResource TextMutedBrush}" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Width" Duration="0:0:0.2" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.dotBar.reachable">
      <Setter Property="Background" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="Border.dotBar.active">
      <Setter Property="Width" Value="24" />
      <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
    </Style>

    <Style Selector="Ellipse.bullet">
      <Setter Property="Width" Value="4" />
      <Setter Property="Height" Value="4" />
      <Setter Property="Fill" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Margin" Value="2,8,0,0" />
    </Style>
    <Style Selector="Ellipse.badgeDot">
      <Setter Property="Width" Value="6" />
      <Setter Property="Height" Value="6" />
      <Setter Property="Fill" Value="{DynamicResource AppAccentBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- The fixed first-run header, the download strip under it and the page dots. -->
    <Style Selector="StackPanel.greeting">
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="Spacing" Value="14" />
      <Setter Property="Margin" Value="0,54,0,20" />
    </Style>
    <Style Selector="Border.logo">
      <Setter Property="Width" Value="56" />
      <Setter Property="Height" Value="56" />
      <Setter Property="CornerRadius" Value="28" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Background" Value="{DynamicResource AccentFillBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
    </Style>
    <Style Selector="Border.strip">
      <Setter Property="Background" Value="{DynamicResource Surface1Brush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Border0Brush}" />
      <Setter Property="BorderThickness" Value="0,1,0,0" />
      <Setter Property="Padding" Value="16,8" />
    </Style>
    <Style Selector="StackPanel.pager">
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="Spacing" Value="10" />
      <Setter Property="Margin" Value="0,10,0,14" />
    </Style>

    <!-- The window outline: sides and bottom around the page, with a short tick past the tab bar's line. -->
    <Style Selector="Border.outline">
      <Setter Property="BorderBrush" Value="{DynamicResource WindowOutlineBrush}" />
      <Setter Property="BorderThickness" Value="1,0,1,1" />
    </Style>
    <Style Selector="Border.outlineTick">
      <Setter Property="Width" Value="1" />
      <Setter Property="Margin" Value="0,-12,0,0" />
      <Setter Property="Background" Value="{DynamicResource WindowOutlineBrush}" />
    </Style>
  </Window.Styles>

  <Window.Resources>
    <!-- Below every provider's fields: the check's failure, then the page's one button, which spins while
         connecting, shows the pass for a moment, then the flow moves on. -->
    <DataTemplate x:Key="ContinueRow" x:DataType="ui:ConnectPage">
      <StackPanel Classes="section">
        <Border Classes="callout error" IsVisible="{Binding IsFailed}">
          <StackPanel Classes="heading">
            <TextBlock Classes="error title" Text="Could not connect" />
            <TextBlock Text="{Binding Error}" />
          </StackPanel>
        </Border>
        <Button Classes="accent big" Classes.accentGreen="{Binding IsConnected}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                IsEnabled="{Binding ButtonEnabled}" Command="{Binding Continue}">
          <StackPanel Classes="buttons">
            <fa:ProgressRing Width="16" Height="16" IsIndeterminate="True" Foreground="{DynamicResource AppAccentBrush}"
                             IsVisible="{Binding IsConnecting}" />
            <fa:SymbolIcon Symbol="Checkmark" FontSize="16" IsVisible="{Binding IsConnected}" />
            <TextBlock Foreground="{Binding $parent[ContentPresenter].Foreground}" Text="{Binding ContinueText}" />
          </StackPanel>
        </Button>
        <TextBlock Classes="ok" HorizontalAlignment="Center" IsVisible="{Binding HasSaved}" Text="{Binding Saved}" />
      </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="ActivityView" x:DataType="ui:Activity">
      <StackPanel Classes="section">
        <StackPanel Classes="field" IsVisible="{Binding Progressing}">
          <ProgressBar Minimum="0" Maximum="100" Value="{Binding Percent}" IsIndeterminate="{Binding Indeterminate}" />
          <TextBlock Classes="dim" Text="{Binding Status}" />
        </StackPanel>
        <Border Classes="callout warning" IsVisible="{Binding IsWaiting}">
          <StackPanel Classes="section">
            <TextBlock Classes="warning" Text="{Binding Waiting}" />
            <ProgressBar IsIndeterminate="True" />
          </StackPanel>
        </Border>
        <Button Content="Cancel" HorizontalAlignment="Left" IsVisible="{Binding Running}" Command="{Binding Cancel}" />
        <TextBlock Classes="error" IsVisible="{Binding HasError}" Text="{Binding Error}" />
      </StackPanel>
    </DataTemplate>
  </Window.Resources>

  <Window.DataTemplates>

    <DataTemplate DataType="ui:SetupFlow">
      <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel Classes="greeting">
          <Border Classes="logo">
            <TextBlock Classes="logo" Text="V" />
          </Border>
          <StackPanel Classes="heading" VerticalAlignment="Center">
            <TextBlock Classes="h1" Text="Hi, I'm Veronica" />
            <TextBlock Classes="dim" Text="Your Space Engineers 2 modding Co-Engineer" />
          </StackPanel>
        </StackPanel>

        <ContentControl Grid.Row="1" Content="{Binding Slides}" />

        <Border Grid.Row="2" Classes="strip" IsVisible="{Binding Files.Visible}">
          <StackPanel Classes="field">
            <StackPanel Classes="field" IsVisible="{Binding Files.Activity.Progressing}">
              <TextBlock Classes="dim" Text="{Binding Files.Activity.Status}" />
              <ProgressBar Minimum="0" Maximum="100" Value="{Binding Files.Activity.Percent}" IsIndeterminate="{Binding Files.Activity.Indeterminate}" />
            </StackPanel>
            <StackPanel Classes="buttons" IsVisible="{Binding Files.Activity.IsWaiting}">
              <TextBlock Classes="warning" Text="{Binding Files.Activity.Waiting}" />
              <Button Classes="link" Content="Stop" Command="{Binding Files.Activity.Cancel}" />
            </StackPanel>
            <StackPanel Classes="buttons" IsVisible="{Binding Files.Activity.HasError}">
              <TextBlock Classes="error" Text="{Binding Files.Activity.Error, StringFormat='Installation failed: {0}'}" />
              <Button Classes="link" Content="Try again" Command="{Binding Files.Retry}" />
            </StackPanel>
            <TextBlock Classes="ok" IsVisible="{Binding Files.Done}" Text="Installed." />
          </StackPanel>
        </Border>
      </Grid>
    </DataTemplate>

    <DataTemplate DataType="ui:Slides">
      <Grid RowDefinitions="*,Auto">
        <ui:SlideCarousel SelectedIndex="{Binding Index, Mode=OneWay}" ItemsSource="{Binding Pages}">
          <ui:SlideCarousel.PageTransition>
            <PageSlide Duration="0:0:0.28" Orientation="Horizontal" />
          </ui:SlideCarousel.PageTransition>
        </ui:SlideCarousel>
        <StackPanel Grid.Row="1" Classes="pager">
          <Button Classes="arrow" Command="{Binding Previous}" IsEnabled="{Binding CanPrevious}" ToolTip.Tip="Previous page">
            <Path Data="M 6,1 L 1,6 L 6,11" />
          </Button>
          <ItemsControl ItemsSource="{Binding Dots}" VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Classes="inline" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="ui:Dot">
                <Button Classes="bare" Command="{Binding Go}" IsEnabled="{Binding IsReachable}">
                  <Border Classes="dotBar" Classes.active="{Binding IsActive}" Classes.reachable="{Binding IsReachable}" />
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Classes="arrow" Command="{Binding Next}" IsEnabled="{Binding CanNext}" ToolTip.Tip="Next page">
            <Path Data="M 1,1 L 6,6 L 1,11" />
          </Button>
        </StackPanel>
      </Grid>
    </DataTemplate>

    <DataTemplate DataType="ui:WelcomeSlide">
      <Grid Classes="page" RowDefinitions="*,Auto">
        <ScrollViewer>
          <StackPanel Classes="chapters">
            <StackPanel Classes="section">
              <TextBlock Classes="h2" Text="Install folder" />
              <Grid Classes="row" ColumnDefinitions="*,Auto">
                <TextBlock TextTrimming="CharacterEllipsis" Text="{Binding Folder}" ToolTip.Tip="{Binding Folder}" />
                <Button Grid.Column="1" Content="Change..." Command="{Binding Change}" IsVisible="{Binding !Locked}" />
              </Grid>
              <TextBlock Classes="dim warning" IsVisible="{Binding HasWarning}" Text="{Binding Warning}" />
            </StackPanel>
            <StackPanel Classes="section" IsVisible="{Binding !Locked}">
              <TextBlock Classes="h2" Text="Shortcuts" />
              <CheckBox Content="Start menu" IsChecked="{Binding StartMenuShortcut}" />
              <CheckBox Content="Desktop" IsChecked="{Binding DesktopShortcut}" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Classes="section">
          <TextBlock Classes="error" HorizontalAlignment="Center" TextAlignment="Center" IsVisible="{Binding HasError}" Text="{Binding Error}" />
          <Button Classes="accent big" HorizontalAlignment="Center" Content="Let's get started" Command="{Binding Start}" />
        </StackPanel>
      </Grid>
    </DataTemplate>

    <DataTemplate DataType="ui:ChooseSlide">
      <ScrollViewer>
        <StackPanel Classes="page">
          <StackPanel Classes="heading">
            <TextBlock Classes="h2" Text="Where does my brain run?" />
            <TextBlock Classes="dim" Text="You can switch any time." />
          </StackPanel>
          <ItemsControl ItemsSource="{Binding Cards}" ItemsPanel="{StaticResource CardList}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="ui:ProviderCard">
                <Button Classes="cardButton" Classes.selected="{Binding Selected}" Command="{Binding Choose}">
                  <StackPanel Classes="heading">
                    <TextBlock Classes="title" Text="{Binding Name}" />
                    <TextBlock Classes="dim" Text="{Binding Pitch}" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </DataTemplate>

    <DataTemplate DataType="ui:ConnectSlide">
      <ContentControl Content="{Binding Content}" />
    </DataTemplate>

    <DataTemplate DataType="ui:LocalConnectPage">
      <ScrollViewer>
        <StackPanel Classes="page">
          <StackPanel Classes="heading">
            <TextBlock Classes="h2" Text="{Binding Name}" />
            <TextBlock Classes="dim" Text="{Binding Pitch}" />
          </StackPanel>
          <Border Classes="card">
            <StackPanel Classes="section">
              <Grid ColumnDefinitions="16,*">
                <Ellipse Classes="bullet" />
                <TextBlock Grid.Column="1">
                  <Run Text="The local model is small and makes mistakes. Trust it, but" />
                  <Run Text="verify." FontWeight="Bold" />
                </TextBlock>
              </Grid>
              <Grid ColumnDefinitions="16,*">
                <Ellipse Classes="bullet" />
                <StackPanel Grid.Column="1" Classes="inline">
                  <TextBlock Text="If its answers don't satisfy you, pick a" />
                  <Button Classes="link" Content="different brain." Command="{Binding Back}" />
                </StackPanel>
              </Grid>
              <Grid ColumnDefinitions="16,*">
                <Ellipse Classes="bullet" />
                <TextBlock Grid.Column="1" Text="The local model is heavy on your graphics card. Applications holding graphics memory slow it down." />
              </Grid>
              <CheckBox Content="I understand" IsChecked="{Binding Understood}" />
            </StackPanel>
          </Border>

          <StackPanel Classes="section">
            <TextBlock Classes="h2" Text="Model" />
            <TextBlock Classes="dim" IsVisible="{Binding !FilesReady}" Text="Models appear once installation finishes." />
            <ItemsControl ItemsSource="{Binding Models}" ItemsPanel="{StaticResource CardGrid}" IsEnabled="{Binding Understood}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="ui:ModelCard">
                  <Button Classes="cardButton" Classes.selected="{Binding Chosen}" Command="{Binding Choose}" VerticalAlignment="Stretch" VerticalContentAlignment="Top">
                    <StackPanel Classes="section">
                      <Grid Classes="row" ColumnDefinitions="*,Auto">
                        <TextBlock Classes="title" Text="{Binding Name}" />
                        <Border Grid.Column="1" Classes="badge ok" IsVisible="{Binding Installed}">
                          <TextBlock Classes="ok" Text="Downloaded" />
                        </Border>
                      </Grid>
                      <TextBlock Classes="dim" IsVisible="{Binding HasDescription}" Text="{Binding Description}" />
                      <Grid Classes="row" ColumnDefinitions="*,Auto">
                        <TextBlock Classes="dim" Text="{Binding Requirements}" />
                        <Button Grid.Column="1" Classes="link" Content="Delete" Command="{Binding Delete}">
                          <Button.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                              <Binding Path="Installed" />
                              <Binding Path="!Activity.Running" />
                            </MultiBinding>
                          </Button.IsVisible>
                        </Button>
                      </Grid>
                      <ContentControl Content="{Binding Activity}" ContentTemplate="{StaticResource ActivityView}" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ContinueRow}" />
        </StackPanel>
      </ScrollViewer>
    </DataTemplate>

    <DataTemplate DataType="ui:ClaudeConnectPage">
      <ScrollViewer>
        <StackPanel Classes="page">
          <StackPanel Classes="heading">
            <TextBlock Classes="h2" Text="{Binding Name}" />
            <TextBlock Classes="dim" Text="{Binding Pitch}" />
          </StackPanel>
          <TextBlock Text="Install Claude Code and sign in by running claude once in a terminal. Then test the connection here." />
          <Expander Header="Advanced" HorizontalAlignment="Stretch">
            <StackPanel Classes="section">
              <StackPanel Classes="field">
                <TextBlock Classes="dim" Text="Model" />
                <TextBox Text="{Binding Model}" Watermark="sonnet" />
              </StackPanel>
              <StackPanel Classes="field">
                <TextBlock Classes="dim" Text="Effort" />
                <TextBox Text="{Binding Effort}" Watermark="Claude Code's default" />
              </StackPanel>
            </StackPanel>
          </Expander>
          <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ContinueRow}" />
        </StackPanel>
      </ScrollViewer>
    </DataTemplate>

    <DataTemplate DataType="ui:OpenAiConnectPage">
      <ScrollViewer>
        <StackPanel Classes="page">
          <StackPanel Classes="heading">
            <TextBlock Classes="h2" Text="{Binding Name}" />
            <TextBlock Classes="dim" Text="{Binding Pitch}" />
          </StackPanel>
          <StackPanel Classes="section">
            <StackPanel Classes="field">
              <TextBlock Classes="dim" Text="Server address (empty for this computer)" />
              <TextBox Text="{Binding Url}" Watermark="localhost" />
            </StackPanel>
            <StackPanel Classes="field">
              <TextBlock Classes="dim" Text="API key (optional, stored encrypted for your Windows user)" />
              <TextBox Text="{Binding ApiKey}" PasswordChar="*" Watermark="API key" />
            </StackPanel>
          </StackPanel>
          <Expander Header="Advanced" HorizontalAlignment="Stretch">
            <StackPanel Classes="section">
              <StackPanel Classes="field">
                <TextBlock Classes="dim" Text="Model" />
                <TextBox Text="{Binding Model}" Watermark="The first model the server lists" />
              </StackPanel>
              <StackPanel Classes="field">
                <TextBlock Classes="dim" Text="Reasoning effort" />
                <TextBox Text="{Binding Effort}" Watermark="The server's default" />
              </StackPanel>
            </StackPanel>
          </Expander>
          <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ContinueRow}" />
        </StackPanel>
      </ScrollViewer>
    </DataTemplate>

    <DataTemplate DataType="ui:AppShell">
      <ContentControl Classes="inApp" Content="{Binding Content}" />
    </DataTemplate>

    <DataTemplate DataType="ui:ModsPane">
      <ScrollViewer>
        <StackPanel Classes="page">
          <StackPanel Classes="heading">
            <TextBlock Classes="h2" Text="Which mods should I help with?" />
            <TextBlock Classes="dim" Text="Installed in a mod, Veronica loads the next time you open it in the Editor." />
          </StackPanel>
          <TextBlock Classes="warning" IsVisible="{Binding HasMessage}" Text="{Binding Message}" />
          <ItemsControl ItemsSource="{Binding Mods}" ItemsPanel="{StaticResource CardList}" Grid.IsSharedSizeScope="True">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="ui:ModCard">
                <Border Classes="card">
                  <Grid Classes="row" ColumnDefinitions="*,Auto">
                    <StackPanel Classes="heading">
                      <TextBlock Classes="title" Text="{Binding Name}" />
                      <TextBlock Classes="dim" Text="{Binding Folder}" />
                      <TextBlock Classes="dim warning" IsVisible="{Binding HasNote}" Text="{Binding Note}" />
                      <ContentControl Content="{Binding Activity}" ContentTemplate="{StaticResource ActivityView}" />
                    </StackPanel>
                    <!-- Shared column widths line the buttons up across the cards, Install as wide as Uninstall. -->
                    <Grid Grid.Column="1" Classes="buttons" VerticalAlignment="Top" IsEnabled="{Binding CanAct}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="ModStart" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="ModInstall" />
                      </Grid.ColumnDefinitions>
                      <Button Content="Start Editor" Command="{Binding Start}" />
                      <Button Grid.Column="1" Classes="accent" Content="Install" Command="{Binding Install}" IsVisible="{Binding !Installed}" />
                      <Button Grid.Column="1" Classes="accentRed" Content="Uninstall" Command="{Binding Uninstall}" IsVisible="{Binding Installed}" />
                    </Grid>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel Classes="section">
            <StackPanel Classes="heading">
              <TextBlock Classes="h2" Text="Editor" />
              <TextBlock Classes="dim" Text="Start Editor opens a mod in this Editor." />
            </StackPanel>
            <Grid Classes="row" ColumnDefinitions="*,Auto">
              <TextBlock TextTrimming="CharacterEllipsis" Text="{Binding EditorText}" ToolTip.Tip="{Binding Editor}" />
              <Button Grid.Column="1" Content="Change..." Command="{Binding ChangeEditor}" />
            </Grid>
          </StackPanel>
          <StackPanel Classes="section">
            <StackPanel Classes="heading">
              <TextBlock Classes="h2" Text="Game" />
              <TextBlock Classes="dim" Text="The Editor runs the mod with this game." />
            </StackPanel>
            <Grid Classes="row" ColumnDefinitions="*,Auto">
              <TextBlock TextTrimming="CharacterEllipsis" Text="{Binding GameText}" ToolTip.Tip="{Binding Game}" />
              <Button Grid.Column="1" Content="Change..." Command="{Binding ChangeGame}" />
            </Grid>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </DataTemplate>

    <DataTemplate DataType="ui:UpdatesPane">
      <ScrollViewer>
        <StackPanel Classes="page">
          <TextBlock Classes="h2" Text="Updates" />
          <Border Classes="card">
            <StackPanel Classes="section">
              <TextBlock Text="{Binding Installed}" />
              <TextBlock Classes="dim" Classes.ok="{Binding UpToDate}" Text="{Binding Latest}" />
              <StackPanel Classes="buttons" IsVisible="{Binding !Activity.Running}">
                <Button Classes="accent" Content="Update" IsVisible="{Binding CanUpdate}" Command="{Binding Update}" />
                <Button Content="Check again" Command="{Binding Check}" />
              </StackPanel>
              <ContentControl Content="{Binding Activity}" ContentTemplate="{StaticResource ActivityView}" />
            </StackPanel>
          </Border>
          <Border Classes="callout warning" IsVisible="{Binding HasWarning}">
            <TextBlock Classes="warning" Text="{Binding Warning}" />
          </Border>
          <StackPanel Classes="section" IsVisible="{Binding HasConflicts}">
            <StackPanel Classes="heading">
              <TextBlock Classes="h2" Text="Files you changed" />
              <TextBlock Classes="dim" Text="You edited these skill or wiki files. The new version of each waits beside it as name.new.md until you choose." />
            </StackPanel>
            <TextBlock Classes="error" IsVisible="{Binding HasConflictsMessage}" Text="{Binding ConflictsMessage}" />
            <ItemsControl ItemsSource="{Binding Conflicts}" ItemsPanel="{StaticResource CardList}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="ui:ConflictCard">
                  <Border Classes="card">
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                      <StackPanel Classes="heading" VerticalAlignment="Center">
                        <TextBlock Classes="title" Text="{Binding Name}" />
                        <TextBlock Classes="dim" Text="{Binding Note}" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Classes="buttons" VerticalAlignment="Center">
                        <Button Content="Open" Command="{Binding Open}" />
                        <Button Content="Keep mine" Command="{Binding KeepMine}" />
                        <Button Classes="accent" Content="Use new version" Command="{Binding UseNew}" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </DataTemplate>

    <DataTemplate DataType="ui:ErrorPage">
      <StackPanel Classes="page" HorizontalAlignment="Center">
        <TextBlock Classes="h1" Text="Something went wrong" />
        <Border Classes="callout error">
          <TextBlock Text="{Binding Message}" />
        </Border>
        <StackPanel Classes="buttons">
          <Button Classes="accent" Content="Try again" Command="{Binding Retry}" />
          <Button Content="Close" Command="{Binding Close}" />
        </StackPanel>
      </StackPanel>
    </DataTemplate>

  </Window.DataTemplates>

  <DockPanel>
    <StackPanel x:Name="Toolbar" DockPanel.Dock="Top">
      <fa:NavigationView x:Name="NavView"
                         PaneDisplayMode="Top"
                         IsBackButtonVisible="False"
                         IsSettingsVisible="False"
                         Background="{DynamicResource Surface1Brush}">
        <fa:NavigationView.MenuItems>
          <fa:NavigationViewItem Content="Initial Setup" Tag="setup" IsVisible="{Binding !IsApp}">
            <fa:NavigationViewItem.IconSource>
              <fa:SymbolIconSource Symbol="Setting" />
            </fa:NavigationViewItem.IconSource>
          </fa:NavigationViewItem>
          <fa:NavigationViewItem Content="Mods" Tag="0" IsVisible="{Binding IsApp}">
            <fa:NavigationViewItem.IconSource>
              <fa:SymbolIconSource Symbol="Library" />
            </fa:NavigationViewItem.IconSource>
          </fa:NavigationViewItem>
          <fa:NavigationViewItem Content="Brain" Tag="1" IsVisible="{Binding IsApp}">
            <fa:NavigationViewItem.IconSource>
              <fa:ImageIconSource>
                <fa:ImageIconSource.Source>
                  <DrawingImage>
                    <DrawingImage.Drawing>
                      <GeometryDrawing Geometry="M 9.5,18.5 H 14.5 M 10.5,21 H 13.5 M 12,3 A 6,6 0 0 0 8.5,13.9 C 9.3,14.6 9.5,15.3 9.5,16 V 16.5 H 14.5 V 16 C 14.5,15.3 14.7,14.6 15.5,13.9 A 6,6 0 0 0 12,3 Z">
                        <GeometryDrawing.Pen>
                          <Pen Brush="{DynamicResource AppDimmedBrush}" Thickness="1.5" LineCap="Round" LineJoin="Round" />
                        </GeometryDrawing.Pen>
                      </GeometryDrawing>
                    </DrawingImage.Drawing>
                  </DrawingImage>
                </fa:ImageIconSource.Source>
              </fa:ImageIconSource>
            </fa:NavigationViewItem.IconSource>
          </fa:NavigationViewItem>
          <fa:NavigationViewItem Tag="2" IsVisible="{Binding IsApp}">
            <fa:NavigationViewItem.IconSource>
              <fa:SymbolIconSource Symbol="CloudDownload" />
            </fa:NavigationViewItem.IconSource>
            <StackPanel Classes="inline">
              <TextBlock Text="Updates" VerticalAlignment="Center" />
              <Ellipse Classes="badgeDot" IsVisible="{Binding App.Updates.NeedsAttention, FallbackValue=False}" />
            </StackPanel>
          </fa:NavigationViewItem>
        </fa:NavigationView.MenuItems>
      </fa:NavigationView>
      <Panel Height="2">
        <Border Background="{DynamicResource Border0Brush}" />
        <Border Classes="outlineTick" HorizontalAlignment="Left" />
        <Border Classes="outlineTick" HorizontalAlignment="Right" />
      </Panel>
    </StackPanel>
    <Border Classes="outline">
      <ContentControl Content="{Binding Page}" />
    </Border>
  </DockPanel>
</Window>
