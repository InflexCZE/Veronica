<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="using:FluentAvalonia.UI.Controls"
        xmlns:ui="using:Veronica.Setup.Ui"
        x:Class="Veronica.Setup.Ui.MainWindow"
        x:DataType="ui:MainViewModel"
        Title="{Binding Title}"
        Width="1090" Height="664" MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Surface0Brush}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="PreferSystemChrome"
        ExtendClientAreaTitleBarHeightHint="-1">

  <Window.Styles>
    <Style Selector="Button.bare">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="3" />
    </Style>
    <Style Selector="Button.bare:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.bare:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.bare:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Button.arrow">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.arrow Path">
      <Setter Property="Stroke" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.arrow:disabled Path">
      <Setter Property="Stroke" Value="{DynamicResource TextMutedBrush}" />
    </Style>
    <Style Selector="Button.arrow:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Border.dotBar">
      <Setter Property="Width" Value="8" />
      <Setter Property="Height" Value="8" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Background" Value="{DynamicResource TextMutedBrush}" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Width" Duration="0:0:0.2" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.dotBar.reachable">
      <Setter Property="Background" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="Border.dotBar.active">
      <Setter Property="Width" Value="24" />
      <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
    </Style>

    <Style Selector="Ellipse.bullet">
      <Setter Property="Width" Value="4" />
      <Setter Property="Height" Value="4" />
      <Setter Property="Fill" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Margin" Value="2,8,0,0" />
    </Style>

    <!-- First-run pages sit centered under the header; inside the app they line up with the other tabs.
         Margin and width live in styles only, since a value set on the element would beat the in-app style. -->
    <Style Selector="StackPanel.page">
      <Setter Property="Margin" Value="24,0" />
      <Setter Property="MaxWidth" Value="560" />
    </Style>
    <Style Selector="ContentControl.inApp StackPanel.page">
      <Setter Property="MaxWidth" Value="Infinity" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Margin" Value="24,18,24,0" />
    </Style>

    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="Margin" Value="0,0,0,2" />
    </Style>
  </Window.Styles>

  <Window.Resources>
    <!-- Below every provider's fields: the check's result and Continue. -->
    <!-- The page's one button: it spins while connecting, shows the pass for a moment, then the flow moves on. -->
    <DataTemplate x:Key="ContinueRow" x:DataType="ui:ConnectPage">
      <StackPanel Spacing="8" Margin="0,4,0,0">
        <Button Classes="accent big" Classes.accentGreen="{Binding IsConnected}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                IsEnabled="{Binding ButtonEnabled}" Command="{Binding Continue}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <fa:ProgressRing Width="16" Height="16" IsIndeterminate="True" Foreground="{DynamicResource AppAccentBrush}"
                             IsVisible="{Binding IsConnecting}" />
            <fa:SymbolIcon Symbol="Checkmark" FontSize="16" IsVisible="{Binding IsConnected}" />
            <TextBlock VerticalAlignment="Center" FontSize="13" Foreground="{Binding $parent[ContentPresenter].Foreground}" Text="{Binding ContinueText}" />
          </StackPanel>
        </Button>
        <Border Classes="callout error" IsVisible="{Binding IsFailed}">
          <StackPanel Spacing="2">
            <TextBlock Classes="error cardTitle" Text="Could not connect" />
            <TextBlock Text="{Binding Error}" />
          </StackPanel>
        </Border>
        <TextBlock Classes="ok" HorizontalAlignment="Center" IsVisible="{Binding HasSaved}" Text="{Binding Saved}" />
      </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="ActivityView" x:DataType="ui:Activity">
      <StackPanel Spacing="6">
        <StackPanel Spacing="4" IsVisible="{Binding Progressing}">
          <ProgressBar Minimum="0" Maximum="100" Value="{Binding Percent}" IsIndeterminate="{Binding Indeterminate}" />
          <TextBlock Classes="caption" Text="{Binding Status}" />
        </StackPanel>
        <Border Classes="callout warning" IsVisible="{Binding IsWaiting}">
          <StackPanel Spacing="6">
            <TextBlock Classes="warning" Text="{Binding Waiting}" />
            <ProgressBar IsIndeterminate="True" />
          </StackPanel>
        </Border>
        <Button Content="Cancel" HorizontalAlignment="Left" IsVisible="{Binding Running}" Command="{Binding Cancel}" />
        <TextBlock Classes="error" IsVisible="{Binding HasError}" Text="{Binding Error}" />
      </StackPanel>
    </DataTemplate>
  </Window.Resources>

  <Window.DataTemplates>

    <DataTemplate DataType="ui:SetupFlow">
      <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="14" Margin="0,18,0,20">
          <Border Width="56" Height="56" CornerRadius="28" BorderThickness="1"
                  Background="{DynamicResource AccentFillBrush}" BorderBrush="{DynamicResource AppAccentBrush}">
            <TextBlock Text="V" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource AppAccentBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel VerticalAlignment="Center" Spacing="2">
            <TextBlock Classes="h1" Text="Hi, I'm Veronica" />
            <TextBlock Classes="dim" Text="Your Space Engineers 2 modding Co-Engineer" />
          </StackPanel>
        </StackPanel>

        <ContentControl Grid.Row="1" Content="{Binding Slides}" />

        <Border Grid.Row="2" IsVisible="{Binding Files.Visible}" Background="{DynamicResource Surface1Brush}"
                BorderBrush="{DynamicResource Border0Brush}" BorderThickness="0,1,0,0" Padding="16,8">
          <StackPanel Spacing="4">
            <StackPanel Spacing="4" IsVisible="{Binding Files.Activity.Progressing}">
              <TextBlock Classes="caption" Text="{Binding Files.Activity.Status}" />
              <ProgressBar Minimum="0" Maximum="100" Value="{Binding Files.Activity.Percent}" IsIndeterminate="{Binding Files.Activity.Indeterminate}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding Files.Activity.IsWaiting}">
              <TextBlock Classes="warning" FontSize="12" VerticalAlignment="Center" Text="{Binding Files.Activity.Waiting}" />
              <Button Classes="link" FontSize="12" VerticalAlignment="Center" Content="Stop" Command="{Binding Files.Activity.Cancel}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding Files.Activity.HasError}">
              <TextBlock Classes="error" FontSize="12" VerticalAlignment="Center" Text="{Binding Files.Activity.Error, StringFormat='Installation failed: {0}'}" />
              <Button Classes="link" FontSize="12" VerticalAlignment="Center" Content="Try again" Command="{Binding Files.Retry}" />
            </StackPanel>
            <TextBlock Classes="ok" FontSize="12" IsVisible="{Binding Files.Done}" Text="Installed." />
          </StackPanel>
        </Border>
      </Grid>
    </DataTemplate>

    <DataTemplate DataType="ui:Slides">
      <Grid RowDefinitions="*,Auto">
        <ui:SlideCarousel SelectedIndex="{Binding Index, Mode=OneWay}" ItemsSource="{Binding Pages}">
          <ui:SlideCarousel.PageTransition>
            <PageSlide Duration="0:0:0.28" Orientation="Horizontal" />
          </ui:SlideCarousel.PageTransition>
        </ui:SlideCarousel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10" Margin="0,10,0,14">
          <Button Classes="arrow" Command="{Binding Previous}" IsEnabled="{Binding CanPrevious}" ToolTip.Tip="Previous page">
            <Path Data="M 6,1 L 1,6 L 6,11" StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round" />
          </Button>
          <ItemsControl ItemsSource="{Binding Dots}" VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="4" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="ui:Dot">
                <Button Classes="bare" Command="{Binding Go}" IsEnabled="{Binding IsReachable}" VerticalAlignment="Center">
                  <Border Classes="dotBar" Classes.active="{Binding IsActive}" Classes.reachable="{Binding IsReachable}" />
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Classes="arrow" Command="{Binding Next}" IsEnabled="{Binding CanNext}" ToolTip.Tip="Next page">
            <Path Data="M 1,1 L 6,6 L 1,11" StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round" />
          </Button>
        </StackPanel>
      </Grid>
    </DataTemplate>

    <DataTemplate DataType="ui:WelcomeSlide">
      <ScrollViewer>
        <StackPanel Spacing="14" MaxWidth="540" Margin="24,0">
          <TextBlock Text="I help you mod Space Engineers 2 right inside the Editor, no programming needed." />
          <StackPanel Spacing="6">
            <TextBlock Text="Together we can:" />
            <Grid ColumnDefinitions="16,*">
              <Ellipse Classes="bullet" />
              <TextBlock Grid.Column="1" Text="Find any content in the game and explain how it works" />
            </Grid>
            <Grid ColumnDefinitions="16,*">
              <Ellipse Classes="bullet" />
              <TextBlock Grid.Column="1" Text="Turn your idea into new blocks, prefabs and definitions, step by step" />
            </Grid>
            <Grid ColumnDefinitions="16,*">
              <Ellipse Classes="bullet" />
              <TextBlock Grid.Column="1" Text="Tweak what is already there, from a single value to a whole set of blocks" />
            </Grid>
          </StackPanel>
          <Border Classes="callout warning" IsVisible="{Binding HasWarning}">
            <TextBlock Classes="warning" Text="{Binding Warning}" />
          </Border>
          <Button Classes="accent big" HorizontalAlignment="Center" Margin="0,6,0,0" Content="Let's get started" Command="{Binding Start}" />
          <TextBlock Classes="caption" HorizontalAlignment="Center" TextAlignment="Center" Text="{Binding Root}" />
          <TextBlock Classes="caption" TextAlignment="Center"
                     Text="Files download in the background while you set up the brain. After that, you choose the mods Veronica helps with." />
        </StackPanel>
      </ScrollViewer>
    </DataTemplate>

    <DataTemplate DataType="ui:ChooseSlide">
      <ScrollViewer>
        <StackPanel Classes="page" Spacing="10">
          <TextBlock Text="Where does my brain run? You can switch any time." Margin="0,0,0,4" />
          <ItemsControl ItemsSource="{Binding Cards}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="ui:ProviderCard">
                <Button Classes="cardButton" Classes.selected="{Binding Selected}" Command="{Binding Choose}" Margin="0,0,0,8">
                  <StackPanel Spacing="3">
                    <TextBlock Classes="cardTitle" Text="{Binding Name}" />
                    <TextBlock Classes="dim" Text="{Binding Pitch}" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </DataTemplate>

    <DataTemplate DataType="ui:ConnectSlide">
      <ContentControl Content="{Binding Content}" />
    </DataTemplate>

    <DataTemplate DataType="ui:LocalConnectPage">
      <ScrollViewer>
        <StackPanel Classes="page" Spacing="14">
          <StackPanel Spacing="3">
            <TextBlock Classes="h2" Text="{Binding Name}" />
            <TextBlock Classes="dim" Text="{Binding Pitch}" />
          </StackPanel>
          <Border Classes="card">
            <StackPanel Spacing="6">
              <Grid ColumnDefinitions="16,*">
                <Ellipse Classes="bullet" />
                <TextBlock Grid.Column="1">
                  <Run Text="The local model is small and makes mistakes. Trust it, but" />
                  <Run Text="verify." FontWeight="Bold" />
                </TextBlock>
              </Grid>
              <Grid ColumnDefinitions="16,*">
                <Ellipse Classes="bullet" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                  <TextBlock Text="If its answers don't satisfy you, pick a" />
                  <Button Classes="link" FontSize="13" Content="different brain." Command="{Binding Back}" />
                </StackPanel>
              </Grid>
              <Grid ColumnDefinitions="16,*">
                <Ellipse Classes="bullet" />
                <TextBlock Grid.Column="1" Text="The local model is heavy on your graphics card. Applications holding graphics memory slow it down." />
              </Grid>
              <CheckBox Content="I understand" IsChecked="{Binding Understood}" Margin="0,4,0,0" />
            </StackPanel>
          </Border>

          <StackPanel Spacing="8">
            <TextBlock Classes="cardTitle" Text="Model" />
            <TextBlock Classes="dim" IsVisible="{Binding !FilesReady}" Text="Models appear once installation finishes." />
            <ItemsControl ItemsSource="{Binding Models}" IsEnabled="{Binding Understood}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="2" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="ui:ModelCard">
                  <Button Classes="cardButton" Classes.selected="{Binding Chosen}" Command="{Binding Choose}" Margin="0,0,8,8" VerticalAlignment="Stretch" VerticalContentAlignment="Top">
                    <StackPanel Spacing="4">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Classes="h2" Text="{Binding Name}" />
                        <Border Grid.Column="1" VerticalAlignment="Center" CornerRadius="3" Padding="6,2" IsVisible="{Binding Installed}"
                                Background="{DynamicResource StatusCompleteFillBrush}">
                          <TextBlock Classes="caption ok" Text="Downloaded" />
                        </Border>
                      </Grid>
                      <TextBlock Classes="dim" IsVisible="{Binding HasDescription}" Text="{Binding Description}" />
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Classes="caption" VerticalAlignment="Center" Text="{Binding Requirements}" />
                        <Button Grid.Column="1" Classes="link" FontSize="11" Content="Delete" Command="{Binding Delete}">
                          <Button.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                              <Binding Path="Installed" />
                              <Binding Path="!Activity.Running" />
                            </MultiBinding>
                          </Button.IsVisible>
                        </Button>
                      </Grid>
                      <ContentControl Content="{Binding Activity}" ContentTemplate="{StaticResource ActivityView}" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <TextBlock Classes="caption" Text="One large download, then it works offline. Nothing you type leaves your machine. Needs a graphics card with enough memory for the model." />
          <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ContinueRow}" Margin="0,0,0,8" />
        </StackPanel>
      </ScrollViewer>
    </DataTemplate>

    <DataTemplate DataType="ui:ClaudeConnectPage">
      <ScrollViewer>
        <StackPanel Classes="page" Spacing="14">
          <StackPanel Spacing="3">
            <TextBlock Classes="h2" Text="{Binding Name}" />
            <TextBlock Classes="dim" Text="{Binding Pitch}" />
          </StackPanel>
          <TextBlock Text="Install Claude Code and sign in by running claude once in a terminal. Then test the connection here." />
          <Expander Header="Advanced" HorizontalAlignment="Stretch">
            <StackPanel Spacing="10">
              <StackPanel>
                <TextBlock Classes="label" Text="Model" />
                <TextBox Text="{Binding Model}" Watermark="sonnet" />
              </StackPanel>
              <StackPanel>
                <TextBlock Classes="label" Text="Effort" />
                <TextBox Text="{Binding Effort}" Watermark="Claude Code's default" />
              </StackPanel>
            </StackPanel>
          </Expander>
          <TextBlock Classes="caption" Text="Your requests go to Anthropic through your Claude Code, under your subscription's terms." />
          <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ContinueRow}" Margin="0,0,0,8" />
        </StackPanel>
      </ScrollViewer>
    </DataTemplate>

    <DataTemplate DataType="ui:OpenAiConnectPage">
      <ScrollViewer>
        <StackPanel Classes="page" Spacing="14">
          <StackPanel Spacing="3">
            <TextBlock Classes="h2" Text="{Binding Name}" />
            <TextBlock Classes="dim" Text="{Binding Pitch}" />
          </StackPanel>
          <StackPanel>
            <TextBlock Classes="label" Text="Server URL, including the API prefix" />
            <TextBox Text="{Binding Url}" Watermark="http://localhost:8080/v1" />
          </StackPanel>
          <StackPanel>
            <TextBlock Classes="label" Text="API key (optional, stored encrypted for your Windows user)" />
            <TextBox Text="{Binding ApiKey}" PasswordChar="*" Watermark="API key" />
          </StackPanel>
          <Expander Header="Advanced" HorizontalAlignment="Stretch">
            <StackPanel Spacing="10">
              <StackPanel>
                <TextBlock Classes="label" Text="Model" />
                <TextBox Text="{Binding Model}" Watermark="The first model the server lists" />
              </StackPanel>
              <StackPanel>
                <TextBlock Classes="label" Text="Reasoning effort" />
                <TextBox Text="{Binding Effort}" Watermark="The server's default" />
              </StackPanel>
            </StackPanel>
          </Expander>
          <TextBlock Classes="caption" Text="Requests go straight from your machine to this server. Nothing is sent anywhere else." />
          <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ContinueRow}" Margin="0,0,0,8" />
        </StackPanel>
      </ScrollViewer>
    </DataTemplate>

    <DataTemplate DataType="ui:AppShell">
      <ContentControl Classes="inApp" Content="{Binding Content}" />
    </DataTemplate>

    <DataTemplate DataType="ui:ModsPane">
      <DockPanel Margin="24,18,24,0">
        <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,14">
          <TextBlock Classes="h2" Text="Which mods should I help with?" />
          <TextBlock Classes="dim" Text="A mod switched on loads Veronica the next time you open it in the Editor. A collaborator without Veronica in this same folder can't open it." />
          <TextBlock Classes="warning" Margin="0,8,0,0" IsVisible="{Binding HasMessage}" Text="{Binding Message}" />
        </StackPanel>
        <ScrollViewer>
          <ItemsControl ItemsSource="{Binding Mods}" Margin="0,0,0,16">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="ui:ModCard">
                <Border Classes="card" Margin="0,0,0,8">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="3">
                      <TextBlock Classes="cardTitle" Text="{Binding Name}" />
                      <TextBlock Classes="caption" Text="{Binding Folder}" />
                      <TextBlock Classes="caption warning" IsVisible="{Binding HasNote}" Text="{Binding Note}" />
                      <ContentControl Content="{Binding Activity}" ContentTemplate="{StaticResource ActivityView}" Margin="0,4,0,0" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" VerticalAlignment="Top" IsChecked="{Binding On}" IsEnabled="{Binding CanToggle}"
                                  OnContent="" OffContent="" Margin="12,0,0,0" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </DataTemplate>

    <DataTemplate DataType="ui:UpdatesPane">
      <ScrollViewer>
        <StackPanel Spacing="14" Margin="24,18,24,16">
          <TextBlock Classes="h2" Text="Updates" />
          <Border Classes="card">
            <StackPanel Spacing="8">
              <TextBlock Text="{Binding Installed}" />
              <TextBlock Classes="dim" Classes.ok="{Binding UpToDate}" Text="{Binding Latest}" />
              <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding !Activity.Running}">
                <Button Classes="accent" Content="Update" IsVisible="{Binding CanUpdate}" Command="{Binding Update}" />
                <Button Content="Check again" Command="{Binding Check}" />
              </StackPanel>
              <ContentControl Content="{Binding Activity}" ContentTemplate="{StaticResource ActivityView}" />
            </StackPanel>
          </Border>
          <Border Classes="callout warning" IsVisible="{Binding HasWarning}">
            <TextBlock Classes="warning" Text="{Binding Warning}" />
          </Border>
          <StackPanel Spacing="8" IsVisible="{Binding HasConflicts}">
            <TextBlock Classes="cardTitle" Text="Files you changed" />
            <TextBlock Classes="dim" Text="You edited these skill or wiki files. The new version of each waits beside it as name.new.md until you choose." />
            <TextBlock Classes="error" IsVisible="{Binding HasConflictsMessage}" Text="{Binding ConflictsMessage}" />
            <ItemsControl ItemsSource="{Binding Conflicts}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="ui:ConflictCard">
                  <Border Classes="card" Margin="0,0,0,8">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="3" VerticalAlignment="Center">
                        <TextBlock Classes="cardTitle" Text="{Binding Name}" />
                        <TextBlock Classes="caption" Text="{Binding Note}" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Button Content="Open" Command="{Binding Open}" />
                        <Button Content="Keep mine" Command="{Binding KeepMine}" />
                        <Button Classes="accent" Content="Use new version" Command="{Binding UseNew}" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </DataTemplate>

    <DataTemplate DataType="ui:ErrorPage">
      <StackPanel Spacing="12" MaxWidth="540" Margin="24,40,24,0" HorizontalAlignment="Center">
        <TextBlock Classes="h1" Text="Something went wrong" />
        <Border Classes="callout error">
          <TextBlock Text="{Binding Message}" />
        </Border>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Classes="accent" Content="Try again" Command="{Binding Retry}" />
          <Button Content="Close" Command="{Binding Close}" />
        </StackPanel>
      </StackPanel>
    </DataTemplate>

  </Window.DataTemplates>

  <DockPanel>
    <StackPanel x:Name="Toolbar" DockPanel.Dock="Top">
      <fa:NavigationView x:Name="NavView"
                         PaneDisplayMode="Top"
                         IsBackButtonVisible="False"
                         IsSettingsVisible="False"
                         Background="{DynamicResource Surface1Brush}">
        <fa:NavigationView.MenuItems>
          <fa:NavigationViewItem Content="Initial Setup" Tag="setup" IsVisible="{Binding !IsApp}">
            <fa:NavigationViewItem.IconSource>
              <fa:SymbolIconSource Symbol="Setting" />
            </fa:NavigationViewItem.IconSource>
          </fa:NavigationViewItem>
          <fa:NavigationViewItem Content="Mods" Tag="0" IsVisible="{Binding IsApp}">
            <fa:NavigationViewItem.IconSource>
              <fa:SymbolIconSource Symbol="Library" />
            </fa:NavigationViewItem.IconSource>
          </fa:NavigationViewItem>
          <fa:NavigationViewItem Content="Brain" Tag="1" IsVisible="{Binding IsApp}">
            <fa:NavigationViewItem.IconSource>
              <fa:ImageIconSource>
                <fa:ImageIconSource.Source>
                  <DrawingImage>
                    <DrawingImage.Drawing>
                      <GeometryDrawing Geometry="M 9.5,18.5 H 14.5 M 10.5,21 H 13.5 M 12,3 A 6,6 0 0 0 8.5,13.9 C 9.3,14.6 9.5,15.3 9.5,16 V 16.5 H 14.5 V 16 C 14.5,15.3 14.7,14.6 15.5,13.9 A 6,6 0 0 0 12,3 Z">
                        <GeometryDrawing.Pen>
                          <Pen Brush="{DynamicResource AppDimmedBrush}" Thickness="1.5" LineCap="Round" LineJoin="Round" />
                        </GeometryDrawing.Pen>
                      </GeometryDrawing>
                    </DrawingImage.Drawing>
                  </DrawingImage>
                </fa:ImageIconSource.Source>
              </fa:ImageIconSource>
            </fa:NavigationViewItem.IconSource>
          </fa:NavigationViewItem>
          <fa:NavigationViewItem Tag="2" IsVisible="{Binding IsApp}">
            <fa:NavigationViewItem.IconSource>
              <fa:SymbolIconSource Symbol="CloudDownload" />
            </fa:NavigationViewItem.IconSource>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="Updates" VerticalAlignment="Center" />
              <Ellipse Width="6" Height="6" Fill="{DynamicResource AppAccentBrush}" VerticalAlignment="Center"
                       IsVisible="{Binding App.Updates.NeedsAttention, FallbackValue=False}" />
            </StackPanel>
          </fa:NavigationViewItem>
        </fa:NavigationView.MenuItems>
      </fa:NavigationView>
      <Border Height="2" Background="{DynamicResource Border0Brush}" />
    </StackPanel>
    <ContentControl Content="{Binding Page}" />
  </DockPanel>
</Window>
