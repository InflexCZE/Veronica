<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:Veronica.Ui"
             x:Class="Veronica.Ui.ChatView"
             x:DataType="ui:ChatPanelViewModel">

  <UserControl.Resources>
    <FontFamily x:Key="VeronicaUiFont">avares://VRage.UI.Shared/Resources/Fonts/Roboto/Roboto-*.ttf#Roboto</FontFamily>
    <FontFamily x:Key="VeronicaTextFont">Segoe UI, Segoe UI Emoji, Segoe UI Symbol</FontFamily>
  </UserControl.Resources>

  <!-- The Editor's global TextBlock style uses Roboto by relative URI, and Avalonia's glyph fallback
       throws on relative URIs: any glyph Roboto lacks would crash the Editor. Every text control in
       this view therefore gets an absolute or system font. -->
  <UserControl.Styles>
    <Style Selector=":is(TextBlock)">
      <Setter Property="FontFamily" Value="{StaticResource VeronicaUiFont}" />
    </Style>
    <Style Selector="SelectableTextBlock.message">
      <Setter Property="FontFamily" Value="{StaticResource VeronicaTextFont}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="FontSize" Value="{DynamicResource MediumFontSize}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextColor}" />
    </Style>
    <Style Selector="SelectableTextBlock.reasoning">
      <Setter Property="Opacity" Value="0.6" />
    </Style>
    <Style Selector="SelectableTextBlock.tool">
      <Setter Property="FontSize" Value="{DynamicResource SmallFontSize}" />
      <Setter Property="Margin" Value="0,2,0,0" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="FontFamily" Value="{StaticResource VeronicaTextFont}" />
    </Style>
    <Style Selector="TextBlock.author">
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="FontSize" Value="{DynamicResource SmallFontSize}" />
      <Setter Property="Foreground" Value="{DynamicResource HighlightedTextColor}" />
    </Style>
    <Style Selector="Border.message">
      <Setter Property="Background" Value="{DynamicResource SemiDarkGrayColor}" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="Margin" Value="0,0,24,6" />
    </Style>
    <Style Selector="Border.message.user">
      <Setter Property="Background" Value="{DynamicResource PrimaryAccentDarkColor}" />
      <Setter Property="Margin" Value="24,0,0,6" />
    </Style>
    <Style Selector="Border.message.notice">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style Selector="Border.message.notice.error SelectableTextBlock">
      <Setter Property="Foreground" Value="IndianRed" />
    </Style>
    <Style Selector="TextBlock.model">
      <Setter Property="FontFamily" Value="{StaticResource VeronicaTextFont}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="FontSize" Value="{DynamicResource MediumFontSize}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextColor}" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="BorderBrush" Value="{DynamicResource PrimaryAccentDarkColor}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Margin" Value="0,0,0,6" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Button.option">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource PrimaryAccentDarkColor}" />
      <Setter Property="BorderThickness" Value="0,1,0,0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.option:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PrimaryAccentDarkColor}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PrimaryAccentDarkColor}" />
    </Style>
    <Style Selector="Button.option:pressed">
      <Setter Property="RenderTransform" Value="none" />
    </Style>
    <Style Selector="Button.option:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PrimaryAccentDarkColor}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PrimaryAccentDarkColor}" />
    </Style>
    <Style Selector="Button.icon">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="*,Auto,Auto" Margin="6">
    <ScrollViewer x:Name="MessagesScroll" Grid.Row="0">
      <StackPanel>
      <ItemsControl ItemsSource="{Binding Messages}">
        <ItemsControl.DataTemplates>
          <DataTemplate DataType="ui:UserItem">
            <Border Classes="message user">
              <StackPanel>
                <TextBlock Classes="author" Text="You" />
                <SelectableTextBlock Classes="message" Text="{Binding Text}" />
              </StackPanel>
            </Border>
          </DataTemplate>
          <DataTemplate DataType="ui:AssistantItem">
            <Border Classes="message">
              <StackPanel>
                <TextBlock Classes="author" Text="Veronica" />
                <Expander Header="Thinking"
                          IsVisible="{Binding HasReasoning}"
                          IsExpanded="{Binding ThinkingExpanded, Mode=TwoWay}"
                          HorizontalAlignment="Stretch"
                          Margin="0,2,0,2">
                  <SelectableTextBlock Classes="message reasoning" Text="{Binding Reasoning}" />
                </Expander>
                <SelectableTextBlock Classes="message" Text="{Binding Text}" IsVisible="{Binding HasText}" />
                <ItemsControl ItemsSource="{Binding Tools}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="ui:ToolActivity">
                      <SelectableTextBlock Classes="message reasoning tool" Text="{Binding Text}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </DataTemplate>
          <DataTemplate DataType="ui:SubAgentItem">
            <Border Classes="message notice">
              <Expander Header="{Binding Headline}" HorizontalAlignment="Stretch">
                <StackPanel>
                  <ItemsControl ItemsSource="{Binding Steps}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="x:String">
                        <SelectableTextBlock Classes="message reasoning tool" Text="{Binding}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <SelectableTextBlock Classes="message reasoning" Text="{Binding Answer}" IsVisible="{Binding HasAnswer}" Margin="0,4,0,0" />
                </StackPanel>
              </Expander>
            </Border>
          </DataTemplate>
          <DataTemplate DataType="ui:NoticeItem">
            <Border Classes="message notice" Classes.error="{Binding IsError}">
              <SelectableTextBlock Classes="message reasoning" Text="{Binding Text}" />
            </Border>
          </DataTemplate>
        </ItemsControl.DataTemplates>
      </ItemsControl>
      <ContentControl Content="{Binding Card}" IsVisible="{Binding Card, Converter={x:Static ObjectConverters.IsNotNull}}">
        <ContentControl.ContentTemplate>
          <DataTemplate DataType="ui:QuestionCard">
            <Border Classes="card">
              <StackPanel>
                <Grid ColumnDefinitions="*,Auto" Background="{DynamicResource SemiDarkGrayColor}">
                  <TextBlock Grid.Column="0" Classes="model" FontWeight="Bold" Margin="8,6" Text="{Binding Question}" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0">
                    <Button Classes="icon" Content="&lt;" IsVisible="{Binding Paging}" IsEnabled="{Binding CanGoBack}" Command="{Binding PreviousCommand}" ToolTip.Tip="Previous question" />
                    <TextBlock Text="{Binding Position}" IsVisible="{Binding Paging}" VerticalAlignment="Center" Opacity="0.6"
                               FontSize="{DynamicResource SmallFontSize}" Foreground="{DynamicResource PrimaryTextColor}" />
                    <Button Classes="icon" Content="&gt;" IsVisible="{Binding Paging}" IsEnabled="{Binding CanGoForward}" Command="{Binding NextCommand}" ToolTip.Tip="Next question" />
                    <Button Classes="icon" Content="X" Command="{Binding CloseCommand}" ToolTip.Tip="Close without answering" />
                  </StackPanel>
                </Grid>
                <ItemsControl ItemsSource="{Binding Options}" IsVisible="{Binding HasOptions}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="ui:QuestionOption">
                      <Button Classes="option" Command="{Binding Pick}">
                        <TextBlock Classes="model" Text="{Binding Text}" />
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Grid ColumnDefinitions="*,Auto" Margin="8,6">
                  <TextBox Grid.Column="0" Text="{Binding Typed}" Watermark="Type your answer" TextWrapping="Wrap" MaxHeight="120">
                    <TextBox.KeyBindings>
                      <KeyBinding Gesture="Enter" Command="{Binding CommitCommand}" />
                    </TextBox.KeyBindings>
                  </TextBox>
                  <Button Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Bottom" Content="{Binding CommitLabel}" Command="{Binding CommitCommand}" />
                </Grid>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ContentControl.ContentTemplate>
      </ContentControl>
      </StackPanel>
    </ScrollViewer>

    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,6,0,0">
      <TextBox Grid.Column="0"
               Text="{Binding Draft}"
               Watermark="Ask Veronica... (/clear starts a new chat)"
               TextWrapping="Wrap"
               MaxHeight="120">
        <TextBox.KeyBindings>
          <KeyBinding Gesture="Enter" Command="{Binding SubmitCommand}" />
        </TextBox.KeyBindings>
      </TextBox>
      <Button Grid.Column="1"
              Content="{Binding SendLabel}"
              Margin="6,0,0,0"
              VerticalAlignment="Bottom"
              Command="{Binding SendCommand}" />
    </Grid>

    <TextBlock Grid.Row="2"
               Text="{Binding Status}"
               Margin="2,4,0,0"
               FontSize="{DynamicResource SmallFontSize}"
               Foreground="{DynamicResource PrimaryTextColor}"
               Opacity="0.6"
               TextTrimming="CharacterEllipsis" />
  </Grid>
</UserControl>
