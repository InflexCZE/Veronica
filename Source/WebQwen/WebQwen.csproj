<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NativeBinDir>$(RepoRoot)bin\x64\$(Configuration)\</NativeBinDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WebQwen.Native\WebQwen.Native.vcxproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\WebQwen.Native\Engine\manifest.json" Link="manifest.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(NativeBinDir)wq.dll;$(NativeBinDir)webgpu_dawn.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <!-- Dev and test runs only: the product takes these from the Editor. -->
    <None Include="$(DepsDir)dxc\bin\x64\dxcompiler.dll;$(DepsDir)dxc\bin\x64\dxil.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

</Project>
